{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/octacian/backlot/main/schemas/manifest-v1.schema.json",
  "$ref": "#/$defs/Manifest",
  "$defs": {
    "ArtifactSource": {
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path"
      ],
      "description": "ArtifactSource names a file or directory collected before runtime removal."
    },
    "Command": {
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "description": "Name from the project tools map; no implicit shell interpretation."
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Direct argument vector; shell expansion requires an explicit shell command."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "tool"
      ],
      "description": "Command declares an executable tool and direct argument vector."
    },
    "Component": {
      "allOf": [
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "native"
              }
            },
            "required": [
              "runtime"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "image"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "args": {
                    "maxItems": 0
                  },
                  "host_mappings": {
                    "maxItems": 0
                  },
                  "mounts": {
                    "maxItems": 0
                  },
                  "ports": {
                    "additionalProperties": {
                      "properties": {
                        "container_port": {
                          "const": 0
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "runtime": {
                "const": "container"
              }
            },
            "required": [
              "runtime"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "image"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "command"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "image": {
                    "properties": {
                      "literal": {
                        "minLength": 1
                      },
                      "ref": {
                        "properties": {
                          "kind": {
                            "const": "input"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "ports": {
                    "additionalProperties": {
                      "allOf": [
                        {
                          "required": [
                            "container_port"
                          ]
                        },
                        {
                          "properties": {
                            "container_port": {
                              "minimum": 1
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "service"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "readiness"
                ]
              },
              {
                "properties": {
                  "initializes": {
                    "maxItems": 0
                  },
                  "policy": {
                    "const": ""
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "job"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "policy"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "readiness"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "policy": {
                    "type": "string",
                    "enum": [
                      "fresh-only",
                      "each-start"
                    ]
                  },
                  "ports": {
                    "maxProperties": 0
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "fresh-only"
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "initializes": {
                "minItems": 1
              }
            },
            "required": [
              "initializes"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "policy": {
                "const": "each-start"
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "properties": {
              "initializes": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "artifacts": {
          "additionalProperties": {
            "$ref": "#/$defs/ArtifactSource"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object"
        },
        "fixtures": {
          "additionalProperties": {
            "$ref": "#/$defs/Fixture"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object"
        },
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "job"
          ],
          "description": "Explicit discriminator; see the supported values and conditional fields."
        },
        "runtime": {
          "type": "string",
          "enum": [
            "native",
            "container"
          ],
          "description": "Native command or generic container; selects command versus image."
        },
        "command": {
          "$ref": "#/$defs/Command",
          "description": "Explicit native executable tool and argument vector."
        },
        "image": {
          "$ref": "#/$defs/Value",
          "description": "Container image literal or declared input reference."
        },
        "args": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Direct argument vector; shell expansion requires an explicit shell command."
        },
        "policy": {
          "type": "string",
          "enum": [
            "",
            "fresh-only",
            "each-start"
          ],
          "description": "Job scheduling policy; services omit this field."
        },
        "initializes": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Attached volume/directory/allocation generations initialized by a fresh-only job."
        },
        "depends_on": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "type": "array",
          "description": "Explicit ready-service or completed-job dependencies."
        },
        "environment_sets": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Reusable environment sets included in this order."
        },
        "environment": {
          "$ref": "#/$defs/Environment",
          "description": "Component environment layers applied after included sets."
        },
        "resources": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Instance-owned allocations selected explicitly; planning does not provision them."
        },
        "outputs": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Checkout output paths and serialization groups."
        },
        "ports": {
          "additionalProperties": {
            "$ref": "#/$defs/ServicePort"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Named allocated host ports with explicit container listeners when needed."
        },
        "host_mappings": {
          "items": {
            "$ref": "#/$defs/HostMapping"
          },
          "type": "array",
          "description": "Explicit managed origin hostname mappings to the Engine host gateway at each container create."
        },
        "mounts": {
          "items": {
            "$ref": "#/$defs/Mount"
          },
          "type": "array",
          "description": "Container storage/output mounts with exactly one source each."
        },
        "readiness": {
          "$ref": "#/$defs/Probe",
          "description": "Required service probe; process liveness alone is insufficient."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "runtime"
      ],
      "description": "Component declares native or container work with explicit dependencies."
    },
    "Dependency": {
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "description": "Selected dependency component name."
        },
        "condition": {
          "type": "string",
          "enum": [
            "ready",
            "completed"
          ],
          "description": "Wait for a service to be ready or a job to complete successfully."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "component",
        "condition"
      ],
      "description": "Dependency gates execution on another selected component."
    },
    "Environment": {
      "properties": {
        "pass_through": {
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Selected inherited environment variable names; never inherit the full environment."
        },
        "seeds": {
          "items": {
            "type": "string",
            "minLength": 1
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Read-only checkout-relative KEY=value files, layered in declaration order."
        },
        "assign": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "object",
          "description": "Explicit environment assignments applied after seeds."
        },
        "required": {
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "type": "array",
          "uniqueItems": true,
          "description": "Environment keys that must be present after layering."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Environment explicitly layers selected inherited values, literal seeds and assignments."
    },
    "Fixture": {
      "properties": {
        "description": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Value"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value"
      ],
      "description": "Fixture declares a discoverable identity or credential for a component."
    },
    "HostMapping": {
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "description": "Attached and published origin whose canonical hostname is mapped."
        },
        "host": {
          "type": "string",
          "enum": [
            "host-gateway"
          ],
          "description": "Explicit Engine host-gateway token, expanded by Docker at each container create; no copied IP or resolver helper."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "origin",
        "host"
      ],
      "description": "HostMapping explicitly maps a published origin hostname to Docker's host gateway."
    },
    "Input": {
      "allOf": [
        {
          "if": {
            "properties": {
              "generate": {
                "const": "random-hex-32"
              }
            },
            "required": [
              "generate"
            ]
          },
          "then": {
            "properties": {
              "secret": {
                "const": true
              }
            },
            "required": [
              "secret"
            ]
          }
        }
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "generate": {
          "type": "string",
          "enum": [
            "",
            "random-hex-32"
          ]
        },
        "secret": {
          "type": "boolean",
          "description": "Treat the value as sensitive in ordinary plan output."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Input declares a required externally supplied value and its sensitivity."
    },
    "Manifest": {
      "properties": {
        "shared_services": {
          "additionalProperties": {
            "$ref": "#/$defs/SharedService"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object"
        },
        "version": {
          "type": "string",
          "const": "backlot/v1",
          "description": "Contract version; use backlot/v1."
        },
        "project": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "description": "Stable project identifier, independent of branch names."
        },
        "tools": {
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Named executables; planning checks availability without running them."
        },
        "inputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Input"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Explicit external inputs; keep machine credentials out of projects."
        },
        "environments": {
          "additionalProperties": {
            "$ref": "#/$defs/Environment"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Reusable environment layers; include them explicitly."
        },
        "resources": {
          "additionalProperties": {
            "$ref": "#/$defs/Resource"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Instance-owned allocations selected explicitly; planning does not provision them."
        },
        "outputs": {
          "additionalProperties": {
            "$ref": "#/$defs/Output"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "description": "Checkout output paths and serialization groups."
        },
        "components": {
          "additionalProperties": {
            "$ref": "#/$defs/Component"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "minProperties": 1,
          "description": "Reusable native or container services and jobs."
        },
        "scenes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scene"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "type": "object",
          "minProperties": 1,
          "description": "Named workflows with explicit selection and lifetime."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "version",
        "project",
        "components",
        "scenes"
      ],
      "description": "Manifest declares reusable components and independently selected scenes."
    },
    "Mount": {
      "oneOf": [
        {
          "allOf": [
            {
              "required": [
                "resource"
              ]
            },
            {
              "properties": {
                "resource": {
                  "minLength": 1
                }
              }
            },
            {
              "properties": {
                "output": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "origin_ca_cert": {
                  "const": ""
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "required": [
                "output"
              ]
            },
            {
              "properties": {
                "output": {
                  "minLength": 1
                }
              }
            },
            {
              "properties": {
                "resource": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "origin_ca_cert": {
                  "const": ""
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "required": [
                "origin_ca_cert",
                "read_only"
              ]
            },
            {
              "properties": {
                "origin_ca_cert": {
                  "minLength": 1
                },
                "read_only": {
                  "const": true
                }
              }
            },
            {
              "properties": {
                "resource": {
                  "const": ""
                }
              }
            },
            {
              "properties": {
                "output": {
                  "const": ""
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "origin_ca_cert": {
          "type": "string",
          "description": "Attached published managed origin whose public root is mounted as a read-only file; never a key or CA directory."
        },
        "resource": {
          "type": "string",
          "description": "Declared resource name; selection and kind are checked by backlot plan."
        },
        "output": {
          "type": "string",
          "description": "Declared checkout output name attached to the component."
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/",
          "description": "Probe destination or absolute mount target, according to this contract."
        },
        "read_only": {
          "type": "boolean",
          "description": "Mount the declared source read-only."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "target"
      ],
      "description": "Mount connects declared storage, checkout output or a public origin CA to a container path."
    },
    "Output": {
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Safe checkout-relative mutable output path."
        },
        "concurrency_group": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,62}$",
          "description": "Named serialization group for overlapping checkout outputs."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "path",
        "concurrency_group"
      ],
      "description": "Output declares a checkout-relative mutable path and serialization group."
    },
    "Probe": {
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "command"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "command"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "target"
                      ]
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tcp"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "target"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "command"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "target": {
                    "properties": {
                      "ref": {
                        "properties": {
                          "field": {
                            "const": "port"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "service",
                              "resource"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "http"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "allOf": [
              {
                "required": [
                  "target"
                ]
              },
              {
                "allOf": [
                  {
                    "not": {
                      "required": [
                        "command"
                      ]
                    }
                  }
                ]
              },
              {
                "properties": {
                  "target": {
                    "properties": {
                      "ref": {
                        "properties": {
                          "field": {
                            "const": "url"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "resource"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "tcp",
            "http",
            "command"
          ],
          "description": "Explicit discriminator; see the supported values and conditional fields."
        },
        "target": {
          "$ref": "#/$defs/Value",
          "description": "Probe destination or absolute mount target, according to this contract."
        },
        "command": {
          "$ref": "#/$defs/Command",
          "description": "Explicit native executable tool and argument vector."
        },
        "timeout": {
          "type": "string",
          "minLength": 1,
          "description": "Nonnegative Go duration, at most 24h; 0s is unlimited subject to other execution budgets."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "kind",
        "timeout"
      ],
      "description": "Probe declares observed availability and a bounded deadline."
    },
    "Publication": {
      "allOf": [
        {
          "properties": {
            "probe": {
              "properties": {
                "kind": {
                  "const": "http"
                },
                "target": {
                  "required": [
                    "ref"
                  ]
                }
              }
            }
          }
        }
      ],
      "properties": {
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "Declared resource name; selection and kind are checked by backlot plan."
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array",
          "minItems": 1,
          "description": "Nonempty bounded routes inside the owned publication."
        },
        "probe": {
          "$ref": "#/$defs/Probe",
          "description": "Aggregate HTTP readiness through the published origin."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "resource",
        "routes",
        "probe"
      ],
      "description": "Publication requests a symbolic HTTPS origin and owned routes."
    },
    "Reference": {
      "oneOf": [
        {
          "allOf": [
            {
              "properties": {
                "kind": {
                  "const": "input"
                }
              }
            },
            {
              "properties": {
                "name": {
                  "pattern": "^[a-z][a-z0-9_-]{0,62}$"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "properties": {
                "field": {
                  "const": ""
                },
                "port": {
                  "const": ""
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "id",
                    "checkout",
                    "project",
                    "scene"
                  ]
                },
                "kind": {
                  "const": "instance"
                }
              }
            },
            {
              "required": [
                "field"
              ]
            },
            {
              "properties": {
                "name": {
